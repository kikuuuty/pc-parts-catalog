{
  "name": "pc-parts-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "upstream:fetch": "node src/cli.js fetch",
    "upstream:inspect": "node src/cli.js inspect",
    "db:migrate": "node src/cli.js migrate",
    "sync": "node src/cli.js sync",
    "search": "node src/cli.js search",
    "stats": "node src/cli.js stats",
    "verify:plans": "node src/cli.js plans",
    "verify:catalog": "node scripts/verify-all-categories.js",
    "audit:completeness": "node src/cli.js audit-completeness",
    "audit:duplicates": "node src/cli.js audit-duplicates",
    "benchmark:search": "node src/cli.js benchmark-search",
    "verify:search:local": "node scripts/verify-search-local.js",
    "benchmark:ux": "node scripts/benchmark-ux.js",
    "benchmark:facets": "node scripts/benchmark-facets.js",
    "verify:ux:local": "node scripts/verify-ux-api-local.js",
    "diagnose:search": "node scripts/search-diagnostics.js",
    "analyze:search": "node scripts/analyze-search-failures.js",
    "measure:sync:local": "node scripts/measure-sync-cost.js",
    "golden:extended:check": "node scripts/prepare-extended-golden.js",
    "worker:dev": "wrangler dev --local --env local --persist-to .wrangler/state",
    "worker:deploy": "npm run check && node scripts/catalog-release.js deploy",
    "release:verify": "node scripts/catalog-release.js verify",
    "release:sync": "node scripts/catalog-release.js sync",
    "verify:api": "node scripts/verify-api.js",
    "verify:worker:local": "node scripts/verify-worker-local.js",
    "verify:filters:local": "node scripts/verify-filters.js",
    "verify:release:cross-snapshot": "node scripts/verify-cross-snapshot.js",
    "verify:protection": "node --test test/search-protection.test.js",
    "schema:generate": "node scripts/generate-schema.js",
    "schema:check": "node scripts/generate-schema.js --check",
    "test": "node --test",
    "check": "npm run schema:check && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  }
}
